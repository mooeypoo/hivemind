{
  "name": "hivemind",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Moriel Schottlender (https://moriel.tech)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mooeypoo/hivemind.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "depcruise": "depcruise src netlify scripts test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run format:check && npm run test",
    "check:headers": "node scripts/check-headers.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.4",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@netlify/functions": "6.0.2",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.6",
    "jiti": "2.7.0",
    "netlify-cli": "27.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "netlify-cli@27.12.0": true,
    "sharp@0.34.5": true,
    "unix-dgram@2.0.7": true
  }
}
