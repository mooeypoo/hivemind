# Copy to .env for `npm run dev`. In production, set these in Netlify's environment settings.
# docs/discord-setup.md walks through getting every value. Never put a secret in a VITE_* variable.

# Public origin of the site: scheme and host, no path, no trailing slash. Sign-in redirects here
# and mutations must come from it. Keep this local value in .env; set the https:// address in Netlify.
SITE_URL=http://localhost:8888

# Discord OAuth application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your community's Discord server
DISCORD_GUILD_ID=

# Who are Admins: holders of this role, plus these Discord user IDs (comma separated).
# Set either or both. User IDs, not usernames: usernames can change hands, IDs never do.
ADMIN_ROLE_ID=
ADMIN_MEMBER_IDS=

# HMAC key for session cookies: at least 32 random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Only needed if any list uses the tmdb-movie item source
TMDB_READ_TOKEN=

# Public display name of the site
VITE_SITE_NAME=Votable Lists

# Optional: a never-expiring invite (code or link) to show your server's name and icon,
# and a "Join the server" link. Otherwise COMMUNITY_NAME is shown, if set.
DISCORD_INVITE_CODE=
COMMUNITY_NAME=

# Optional: where your fork's source code lives (footer link)
VITE_SOURCE_URL=

# Demo mode: pretend sign-in and sample lists, for trying the site without Discord.
# Works in local dev and Netlify previews; always ignored in production.
DEMO_MODE=true
